generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  password                String?
  firstName               String
  lastName                String
  phoneNumber             String?
  country                 Country               @default(BOLIVIA)
  walletAddress           String?               @unique
  kycStatus               KycStatus             @default(UNVERIFIED)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lastLogin               DateTime?
  role                    UserRole              @default(USER)
  resetPasswordExpiry     DateTime?
  resetPasswordToken      String?
  isGoogleAccount         Boolean               @default(false)
  isOnboardingCompleted   Boolean               @default(false)
  isVerified              Boolean               @default(false)
  bankAccounts            BankAccount[]
  fiatOperations          FiatOperation[]
  validatedFiatOperations FiatOperation[]       @relation("FiatOperationValidatedBy")
  kycDocuments            KycDocument[]
  verificationRequests    VerificationRequest[]

  @@map("users")
}

model KycDocument {
  id         String   @id @default(uuid())
  userId     String
  docType    String
  docUrl     String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("kyc_documents")
}

model FiatOperation {
  id            String              @id @default(uuid())
  type          FiatOperationType
  userId        String
  currency      FiatCurrency
  amount        Decimal             @db.Decimal(36, 18)
  feeRate       Decimal             @db.Decimal(10, 6)
  serviceFee    Decimal             @db.Decimal(36, 18)
  totalAmount   Decimal             @db.Decimal(36, 18)
  rateUsed      Decimal?            @db.Decimal(36, 18)
  rateSource    String?
  rateQuotedAt  DateTime?
  rateExpiresAt DateTime?
  referenceCode String              @unique
  status        FiatOperationStatus @default(PENDING)
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  processedAt   DateTime?
  deposit       DepositDetail?
  user          User                @relation(fields: [userId], references: [id])
  validatedBy   User?               @relation("FiatOperationValidatedBy", fields: [validatedById], references: [id])
  withdrawal    WithdrawalDetail?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("fiat_operations")
}

model DepositDetail {
  id              String        @id @default(uuid())
  operationId     String        @unique
  expectedBOBH    Decimal       @db.Decimal(36, 18)
  mintTxHash      String?
  mintedAt        DateTime?
  proofUrl        String?
  proofUploadedAt DateTime?
  proofFileName   String?
  proofMimeType   String?
  operation       FiatOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("deposit_details")
}

model WithdrawalDetail {
  id            String        @id @default(uuid())
  operationId   String        @unique
  bankAccountId BigInt
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id])
  operation     FiatOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@map("withdrawal_details")
}

model BankAccount {
  id               BigInt             @id @default(autoincrement())
  userId           String
  bankId           Int
  accountNumber    String             @db.VarChar(50)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  bank             Banks              @relation(fields: [bankId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  withdrawaldetail WithdrawalDetail[]

  @@index([userId])
  @@index([bankId])
  @@index([accountNumber])
  @@map("bank_accounts")
}

model Banks {
  name         String
  logo_url     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  country      country_banks
  id           Int           @id @default(autoincrement())
  bankAccounts BankAccount[]
}

model VerificationRequest {
  id        String             @id @default(uuid())
  userId    String
  imageUrl  String
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("verification_requests")
}

enum UserRole {
  USER
  ADMIN
  OPERATOR_BO
  OPERATOR_PE
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  BLACKLISTED
}

enum Country {
  BOLIVIA
  PERU
}

enum FiatOperationType {
  DEPOSIT
  WITHDRAW
}

enum FiatOperationStatus {
  PENDING
  PROOF_SUBMITTED
  RATE_EXPIRED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum FiatCurrency {
  BOB
  PEN
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  MINTED
  PROOF_SUBMITTED
  RATE_EXPIRED
}

enum TransactionType {
  MINT
  BURN
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum Network {
  BNB_CHAIN_MAINNET
  BNB_CHAIN_TESTNET
}

enum country_banks {
  Bolivia
  PERU
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}
