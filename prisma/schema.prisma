generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER // Cliente normal
  ADMIN // Admin
  OPERATOR_BO // Empleado en Bolivia (Valida depósitos)
  OPERATOR_PE // Empleado en Perú (Valida tesorería)
}

enum KycStatus {
  UNVERIFIED // Recién registrado
  PENDING // Subió documentos, espera revisión
  VERIFIED // Aprobado (Puede comprar/vender)
  REJECTED // Documentos inválidos
  BLACKLISTED // Bloqueado por seguridad/OFAC
}

enum Country {
  BOLIVIA
  PERU
}

enum FiatOperationType {
  DEPOSIT
  WITHDRAW
}

enum FiatOperationStatus {
  PENDING
  PROOF_SUBMITTED
  RATE_EXPIRED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum FiatCurrency {
  BOB
  PEN
}

enum DepositStatus {
  PENDING
  PROOF_SUBMITTED
  RATE_EXPIRED
  APPROVED
  REJECTED
  MINTED
}

enum TransactionType {
  MINT
  BURN
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum Network {
  BNB_CHAIN_MAINNET
  BNB_CHAIN_TESTNET
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String?

  firstName   String
  lastName    String
  phoneNumber String?
  country     Country @default(BOLIVIA)

  walletAddress String?   @unique
  kycStatus     KycStatus @default(UNVERIFIED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  isGoogleAccount Boolean @default(false)

  role                  UserRole  @default(USER)
  resetPasswordToken    String?
  resetPasswordExpiry   DateTime?
  isOnboardingCompleted Boolean   @default(false)

  kycDocuments  KycDocument[]
  fiatOperations FiatOperation[]
  bankAccounts  BankAccount[]

  validatedFiatOperations FiatOperation[] @relation("FiatOperationValidatedBy")

  @@map("users")
}

model KycDocument {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  docType    String // e.g., "passport", "ID card"
  docUrl     String // URL to the stored document
  uploadedAt DateTime @default(now())

  @@map("kyc_documents")
}

model FiatOperation {
  id            String            @id @default(uuid())
  type          FiatOperationType

  user          User              @relation(fields: [userId], references: [id])
  userId        String

  // Moneda y monto base (sin fee)
  currency      FiatCurrency
  amount        Decimal           @db.Decimal(36, 18)

  // Fees comunes
  feeRate       Decimal           @db.Decimal(10, 6)
  serviceFee    Decimal           @db.Decimal(36, 18)
  totalAmount   Decimal           @db.Decimal(36, 18)

  // Rate lock común (si aplica)
  rateUsed      Decimal?          @db.Decimal(36, 18)
  rateSource    String?
  rateQuotedAt  DateTime?
  rateExpiresAt DateTime?

  referenceCode String            @unique

  status        FiatOperationStatus @default(PENDING)

  // Auditoría común (aprobación/rechazo)
  validatedById String?
  validatedBy   User?             @relation("FiatOperationValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  processedAt   DateTime?

  // Detalles por tipo (1:1)
  deposit       DepositDetail?
  withdrawal    WithdrawalDetail?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("fiat_operations")
}
 model DepositDetail {
  id            String        @id @default(uuid())

  operation     FiatOperation @relation(fields: [operationId],references: [id],onDelete: Cascade)
  operationId   String        @unique

  expectedBOBH  Decimal       @db.Decimal(36, 18)

  mintTxHash    String?
  mintedAt      DateTime?

  proofUrl        String?
  proofUploadedAt DateTime?
  proofFileName   String?
  proofMimeType   String?

  @@map("deposit_details")
}

model WithdrawalDetail {
  id            String        @id @default(uuid())

  operation     FiatOperation @relation(fields: [operationId],references: [id],onDelete: Cascade)
  operationId   String        @unique

  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id])
  bankAccountId BigInt

  @@index([bankAccountId])
  @@map("withdrawal_details")
}


model BankAccount {
  id            BigInt       @id @default(autoincrement())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  bank          Banks        @relation(fields: [bankId], references: [id])
  bankId        Int
  accountNumber String       @db.VarChar(50)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt

  withdrawaldetail WithdrawalDetail[]

  @@index([userId])
  @@index([bankId])
  @@index([accountNumber])
  @@map("bank_accounts")
}

enum country_banks {
  Bolivia
  PERU
}

model Banks {
  id          Int               @id @default(autoincrement())
  name        String
  country     country_banks
  logo_url    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?         @updatedAt
  bankAccounts BankAccount[]
}
